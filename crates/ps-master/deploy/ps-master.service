# /etc/systemd/system/ps-master.service
[Unit]
Description=Planetstrike master server (server list)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/ps-master --bind 127.0.0.1:27510 --relay-bind 127.0.0.1:27511
Restart=on-failure
RestartSec=5
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
